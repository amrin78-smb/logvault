# ============================================================
# LogVault Environment Configuration
# Save as .env.local in the logvault root directory
# ============================================================

# ── Database (TimescaleDB - logvault database) ───────────────
DB_HOST=localhost
DB_PORT=5432
LV_DB_NAME=logvault
LV_DB_USER=logvault_user
LV_DB_PASS=your-strong-password-here

# ── Service Ports ────────────────────────────────────────────
LV_API_PORT=3005          # Internal API/WebSocket port (Next.js proxies to this)
LV_APP_PORT=3004          # Next.js frontend port (public-facing)

# ── Server / Updates ─────────────────────────────────────────
# Used by the in-app "Check for Updates" feature to schedule the update task.
SERVER_IP=your_server_ip

# ── NocVault Hub (NetVault) ──────────────────────────────────
# Base URL of the NetVault hub. Used client-side for SSO and for the
# "Manage License" link in the trial/license banner, which points to
# NetVault's license settings page ({hub}/settings/license).
NEXT_PUBLIC_NOCVAULT_HUB_URL=http://localhost:3000

# ── Syslog Collector ─────────────────────────────────────────
SYSLOG_PORTS=514,1514     # Comma-separated list of ports to listen on

# ── Retention ────────────────────────────────────────────────
RETENTION_DAYS=90

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=info            # info | debug
NODE_ENV=production
