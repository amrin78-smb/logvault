# ============================================================
# LogVault Environment Configuration
# Save as .env.local in the logvault root directory
# ============================================================

# ── Database (TimescaleDB - logvault database) ───────────────
DB_HOST=localhost
DB_PORT=5432
LV_DB_NAME=logvault
LV_DB_USER=logvault_user
LV_DB_PASS=your-strong-password-here

# postgres superuser password - used ONLY by the update script to apply
# scripts/schema.sql (which needs superuser ownership for the SECURITY DEFINER
# partition functions and the append-only REVOKEs). Not used at runtime.
POSTGRES_PASSWORD=your_postgres_password

# ── Service Ports ────────────────────────────────────────────
LV_API_PORT=3005          # Internal API/WebSocket port (Next.js proxies to this)
# NOTE: LV_APP_PORT is NOT read by the application. The frontend port is set by
# the -p argument NSSM passes to `next start` (see the LogVault-App service), and
# frontend/package.json hardcodes 3004 as the dev/standalone default. It cannot be
# read from here portably: npm scripts run through cmd.exe on Windows, which has no
# ${VAR:-default} expansion, and switching to Next's own PORT variable would make an
# unset value silently fall back to 3000 — colliding with NetVault. Left documented
# because the suite installer sets it; making it authoritative is an installer change.
LV_APP_PORT=3004          # informational only — actual port comes from NSSM -p

# ── Server / Updates ─────────────────────────────────────────
# Used by the in-app "Check for Updates" feature to schedule the update task.
SERVER_IP=your_server_ip

# ── Syslog Collector ─────────────────────────────────────────
# Comma-separated list of ports to listen on (UDP and TCP on each). READ as of
# 2.35.0 — before that it was documented and provisioned but ignored. Changing it
# is a THREE-file change: this value, the two force-kill port loops in
# installer/Update-LogVault.ps1, and the firewall rules in the suite installer.
SYSLOG_PORTS=514,1514

# Requested UDP receive-buffer size in bytes (default 8 MiB). The OS silently
# clamps this — on Linux to net.core.rmem_max, ~212 KB by default — so the
# collector logs the EFFECTIVE size it actually got at startup. If that number is
# far below what you set here, raise the OS limit; the app cannot.
SYSLOG_RECV_BUFFER_BYTES=8388608

# ── Retention ────────────────────────────────────────────────
RETENTION_DAYS=90

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=info            # info | debug
NODE_ENV=production
