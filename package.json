{
  "name": "logvault",
  "version": "2.25.7",
  "description": "LogVault - NexVault Syslog Analyzer. Windows-native, on-premises syslog collection and analysis.",
  "private": true,
  "scripts": {
    "install:all": "npm install && cd frontend && npm install",
    "collector": "node collector/collector.js",
    "api": "node api/server.js",
    "dev:collector": "node collector/collector.js",
    "dev:api": "node api/server.js",
    "dev:frontend": "cd frontend && npm run dev -- --port 3004"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "nodemailer": "^8.0.10",
    "pdfkit": "^0.18.0",
    "pg": "^8.12.0",
    "ws": "^8.17.1"
  }
}
